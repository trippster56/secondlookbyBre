# Canonical origin, no trailing slash. Required in production.
NEXT_PUBLIC_SITE_URL=https://thesecondlookbybre.com

# Without a key, /api/contact logs the enquiry and reports success.
RESEND_API_KEY=
# Defaults to onboarding@resend.dev
RESEND_FROM_EMAIL=
# Defaults to siteConfig.contact.email
RESEND_TO_EMAIL=

# Seed long-lived Instagram token (Instagram API with Instagram Login). The
# daily cron rotates it into blob storage, after which this is only the seed.
# Without it, /take-a-look shows the stills grid instead of the reels feed.
INSTAGRAM_ACCESS_TOKEN=
# Set automatically when a Vercel Blob store is connected. The rotated token
# lives there; without it the token cannot rotate and expires after 60 days.
BLOB_READ_WRITE_TOKEN=
# Any long random string. Vercel's cron sends it as a bearer token; the refresh
# route refuses to run in production without it.
CRON_SECRET=
